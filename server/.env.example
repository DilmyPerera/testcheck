# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Database (see /docker-compose.yml for a local Postgres you can run with `docker compose up -d`)
DATABASE_URL="postgresql://evotec:evotec@localhost:5432/evotec?schema=public"

# JWT
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seeded admin account (created by `npm run prisma:seed`)
SEED_ADMIN_EMAIL=admin@evotec.software
SEED_ADMIN_PASSWORD=Admin1234
