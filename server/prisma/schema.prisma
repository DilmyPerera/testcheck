generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
}

model Submission {
  id           Int       @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String    @unique
  gender       Gender
  mobileNumber String
  address      String
  feedback     String?
  userCreated  String
  dateCreated  DateTime  @default(now())
  userModified String?
  dateModified DateTime?
}
